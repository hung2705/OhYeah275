#!name=Locket Gold VIP & YouTube Premium
#!desc=Hợp nhất tính năng mở khóa Locket Gold VIP (Remote Config, Badges, Frames, Unlimited Friends) và YouTube Premium (Chặn quảng cáo, PiP, Nghe trong nền, Phụ đề song ngữ Tiếng Việt) cho Shadowrocket iOS.
#!category=Enhance
#!system=iOS
#!author=LAMDev & Maasea

[Rule]
# Chặn QUIC (HTTP/3 qua UDP) để buộc YouTube chuyển sang HTTP/2 TCP phục vụ giải mã MITM
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[URL Rewrite]
# Chặn luồng phân phối quảng cáo YouTube trả về HTTP 200 rỗng
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200

# Chặn API thống kê, theo dõi và đo lường quảng cáo YouTube
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

# Chuyển hướng bỏ tham số ctier quảng cáo video YouTube (HTTP 302)
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Header Rewrite]
# Xóa ETag header của RevenueCat để ngăn mã phản hồi 304 Not Modified, buộc trả về dữ liệu thuê bao mới
^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+ header-del x-revenuecat-etag
^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+ header-del X-RevenueCat-ETag

[Map Local]
# Khởi tạo phát video rỗng cho yêu cầu quảng cáo initplayback
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback.+&oad data-type=text data="" status-code=200

[Script]
# ================= YouTube Premium & Adblock =================
# Chặn quảng cáo video/feed/Shorts, mở khóa PiP, phát trong nền và phụ đề song ngữ Tiếng Việt
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{\"captionLang\":\"vi\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

# ================= Locket Gold VIP =================
# 1. Mở khóa gói bản quyền Locket Gold VIP vĩnh viễn qua RevenueCat
revenuecat = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam/locketlam.js,requires-body=true,max-size=-1,timeout=60

# 2. Xóa ETag header ở tầng request script để chống phản hồi 304
deleteHeader = type=http-request,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam/deleteHeader.js,timeout=60

# 3. Mở khóa toàn bộ tính năng Firebase Remote Config (179 cấu hình: Khung widget, Video 60s, 10k bạn bè, Tải ảnh 2560px HD)
locket_rc = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+,script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam/locket_remote.js,requires-body=true,max-size=-1,timeout=60

# 4. Kích hoạt và duy trì Huy hiệu vàng Locket Gold Profile Badge
locket_badge = type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo,script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam/locket_profile.js,timeout=60

# 5. Đồng bộ hóa thông tin người dùng hiển thị huy hiệu vàng trên toàn bộ giao diện app Locket
locket_user = type=http-response,pattern=^https:\/\/api\.locketcamera\.com\/.+,script-path=https://raw.githubusercontent.com/leanhminh2104/locketlam/refs/heads/shadowrocket/locketlam/locket_profile.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% -redirector*.googlevideo.com, *.googlevideo.com, www.youtube.com, s.youtube.com, youtubei.googleapis.com, api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
