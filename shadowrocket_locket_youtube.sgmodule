#!name=Locket Gold VIP & YouTube Premium - hungw.
#!desc=Hợp nhất tính năng mở khóa Locket Gold VIP (317+ Custom Captions, 360+ Remote Config flags, Badges, Custom Widget Frames, Video 60s) và YouTube Premium (Chặn quảng cáo, PiP, Nghe trong nền, Phụ đề Tiếng Việt) bởi hungw.
#!category=Enhance
#!system=iOS
#!author=hungw.
#!homepage=https://github.com/hung2705/OhYeah275

[Rule]
# Chặn toàn bộ UDP port 443 (QUIC / HTTP3) để ngăn triệt để bypass MITM
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT

# Chặn các domain phân phối quảng cáo Google / DoubleClick
DOMAIN,ad.doubleclick.net,REJECT
DOMAIN,googleads.g.doubleclick.net,REJECT
DOMAIN,pagead2.googlesyndication.com,REJECT
DOMAIN,ade.googlesyndication.com,REJECT
DOMAIN,tpc.googlesyndication.com,REJECT


[Header Rewrite]
# Xóa ETag header của RevenueCat để ngăn mã phản hồi 304 Not Modified, buộc trả về dữ liệu thuê bao mới
^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+ header-del x-revenuecat-etag
^https:\/\/(api\.revenuecat\.com|api\.rc-backup\.com)\/.+ header-del X-RevenueCat-ETag

[Script]
# ================= YouTube Premium & Adblock =================
# 1. Chặn quảng cáo video/feed/Shorts, mở khóa PiP, phát trong nền và phụ đề song ngữ Tiếng Việt
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/(youtubei\/v1\/(browse|next|player|search|reel\/reel_watch_sequence|guide|account\/get_setting|get_watch|log_event|config))(\?(.*))?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.response.js,argument="{\"captionLang\":\"vi\",\"blockUpload\":true,\"blockImmersive\":true,\"blockShorts\":false,\"debug\":false}"

# 2. Xử lý yêu cầu khởi tạo phát video (initplayback) loại bỏ quảng cáo đệm
youtube.request.init = type=http-request,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^&]+&)*ack(?:=[^&]*)?(?:&.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js,argument="{\"captionLang\":\"vi\"}"

# 3. Chặn và sửa đổi sự kiện theo dõi quảng cáo (log_event)
youtube.request.log_event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event,requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/Maasea/sgmodule/master/Script/Youtube/youtube.request.js

# ================= Locket Gold VIP - hungw. =================
# 1. Mở khóa gói bản quyền Locket Gold VIP vĩnh viễn qua RevenueCat
revenuecat = type=http-response,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$),script-path=https://raw.githubusercontent.com/hung2705/OhYeah275/refs/heads/main/js/locket_gold.js,requires-body=true,max-size=-1,timeout=60

# 2. Xóa ETag header ở tầng request script để chống phản hồi 304
deleteHeader = type=http-request,pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/hung2705/OhYeah275/refs/heads/main/js/deleteHeader.js,timeout=60

# 3. Mở khóa toàn bộ Firebase Remote Config (360+ cờ tính năng & 317+ Custom Captions độc quyền hungw.)
locket_rc = type=http-response,pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/(locket-4252a|641029076083)\/.+,script-path=https://raw.githubusercontent.com/hung2705/OhYeah275/refs/heads/main/js/locket_remote.js,requires-body=true,max-size=-1,timeout=60

# 4. Kích hoạt và duy trì Huy hiệu vàng Locket Gold Profile Badge
locket_badge = type=http-request,pattern=^https:\/\/api\.locketcamera\.com\/changeProfileInfo,script-path=https://raw.githubusercontent.com/hung2705/OhYeah275/refs/heads/main/js/locket_profile.js,timeout=60

# 5. Đồng bộ hóa thông tin người dùng hiển thị huy hiệu vàng trên toàn bộ giao diện app Locket
locket_user = type=http-response,pattern=^https:\/\/api\.locketcamera\.com\/.+,script-path=https://raw.githubusercontent.com/hung2705/OhYeah275/refs/heads/main/js/locket_profile.js,requires-body=true,max-size=-1,timeout=60

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, api.revenuecat.com, api.rc-backup.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com
